# ============ 必填：源码与部署 ============
# fork 仓库地址（默认你的 fork）
GIT_REPO=https://github.com/necor0703/new-api.git
# 分支 / tag / commit，默认 main；生产建议 pin 一个 commit 或 tag
GIT_REF=main
# 源码落盘目录
SRC_DIR=/root/newapi-src-prod
# 部署目录（compose / data / logs / .env 所在）
DEPLOY_DIR=/app/new-api-prod
# 构建出的镜像 tag（含二开 commit 短号即可追溯）
IMAGE_TAG=new-api:prod-latest
CONTAINER_NAME=new-api-prod
# 对外端口
APP_PORT=3000

# ============ 中间件模式 ============
# host = 复用本机已有 PG/Redis（脚本只建库建账号，不装软件）
# bundled = 本机没有 PG/Redis，compose 顺手起 postgres+redis 两个容器
MW_MODE=host

# ---- host 模式下落库信息（脚本自动建库/建账号/授权，密码随机生成写回 .env） ----
PG_HOST=127.0.0.1
PG_PORT=5432
PG_ADMIN_USER=postgres
PG_DB=newapi
PG_LOG_DB=newapi_log
PG_USER=newapi
# 为空则脚本随机生成 32 位并写回 .env
PG_PASSWORD=
# Redis：为空=无密码；有密码填上；REDIS_DB 避免和别的业务串库
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=1

# ---- bundled 模式专用（compose 起 pg+redis 容器，密码随机生成写回 .env） ----
PG_IMAGE=postgres:15
REDIS_IMAGE=redis:7-alpine
# 为空则脚本随机生成并写回 .env
POSTGRES_PASSWORD=
REDIS_PASSWORD_BUNDLED=

# ============ 运行时（由脚本生成/组装，不要手填） ============
# host 模式脚本按上面 PG_*/REDIS_* 组装：
#   SQL_DSN=postgres://USER:PASS@host.docker.internal:5432/DB?sslmode=disable
# bundled 模式脚本按容器服务名组装：
#   SQL_DSN=postgres://postgres:PASS@postgres:5432/new-api?sslmode=disable
SQL_DSN=
LOG_SQL_DSN=
REDIS_CONN_STRING=

NODE_NAME=new-api-prod-node-1
# 为空则脚本随机生成 64 位 hex 并写回 .env
SESSION_SECRET=
